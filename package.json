{
  "name": "chirimen-raspi-docker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build --projects=runtime,catalog && nx bundle browser-polyfill",
    "serve": "nx serve runtime",
    "lint": "nx run-many -t lint --projects=core,gpio,i2c,protocol,node-runtime,browser-polyfill,runtime,catalog",
    "test": "nx run-many -t test --projects=core,gpio,i2c,protocol,node-runtime,browser-polyfill,runtime,catalog",
    "docs:api": "typedoc",
    "docs:site": "node scripts/build-docs-site.mjs",
    "graph": "nx graph"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-web-gpio": "^1.1.81",
    "node-web-i2c": "^1.1.89",
    "tslib": "^2.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jsonc-eslint-parser": "^3.3.0",
    "marked": "^18.0.13",
    "nx": "23.2.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
