{
  "name": "chirimen-raspi-docker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build --projects=runtime,catalog && nx bundle browser-polyfill",
    "serve": "nx serve runtime",
    "lint": "nx run-many -t lint --projects=core,gpio,i2c,protocol,node-runtime,browser-polyfill,runtime,catalog",
    "test": "nx run-many -t test --projects=core,gpio,i2c,protocol,node-runtime,browser-polyfill,runtime,catalog",
    "docs:api": "typedoc",
    "docs:site": "node scripts/build-docs-site.mjs",
    "graph": "nx graph"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-web-gpio": "^2.0.0",
    "node-web-i2c": "^1.1.92",
    "tslib": "^2.9.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/esbuild": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/node": "24.0.3",
    "@nx/vite": "24.0.3",
    "@nx/vitest": "24.0.3",
    "@nx/web": "24.0.3",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.21",
    "@swc/helpers": "~0.5.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsonc-eslint-parser": "^3.3.0",
    "marked": "^18.1.2",
    "nx": "24.0.3",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
