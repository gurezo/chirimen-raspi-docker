# 32-bit OS (linux/arm/v7). Node 24 has no arm/v7 image, so this file
# uses Node 22. Keep stages in sync with Dockerfile except FROM and the
# build command: Nx native hasher (hashArray) is unreliable on armv7.
FROM node:22-bookworm-slim AS base

WORKDIR /workspace

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.5.2 --activate

FROM base AS deps

# i2c-bus (via node-web-i2c) and other native addons need node-gyp at install time.
# Keep these packages in the deps/build stages only; runtime stays on slim base.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json tsconfig.json ./

RUN pnpm install --frozen-lockfile

FROM deps AS build

COPY . .

# Nx 23 native bindings / WASM fallback fail on linux/arm/v7
# ("hashArray is not a function"). Bundle with esbuild instead.
# Output path matches apps/server/project.json (apps/server/dist/main.js).
RUN node scripts/build-server.mjs

FROM base AS runtime

ENV NODE_ENV="production"
ENV HOST="0.0.0.0"
ENV PORT="33330"

COPY --from=build /workspace /workspace

EXPOSE 33330

CMD ["node", "apps/server/dist/main.js"]
