{
  "name": "example-catalog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/example-catalog/src",
  "projectType": "application",
  "tags": ["type:app", "scope:catalog", "platform:browser"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "apps/example-catalog/dist"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "example-catalog:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "example-catalog:build:development"
        },
        "production": {
          "buildTarget": "example-catalog:build:production"
        }
      }
    },
    "preview": {
      "continuous": true,
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "example-catalog:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "example-catalog:build:development"
        },
        "production": {
          "buildTarget": "example-catalog:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{workspaceRoot}/coverage/apps/example-catalog"
      }
    }
  }
}
