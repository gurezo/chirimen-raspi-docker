{
  "name": "browser-polyfill",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/browser-polyfill/src",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:polyfill",
    "platform:browser"
  ],
  "targets": {
    "bundle": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{workspaceRoot}/libs/browser-polyfill/dist/polyfill.js",
        "{workspaceRoot}/workspace/my-first-example/polyfill.js",
        "{workspaceRoot}/workspace/led-blink/polyfill.js",
        "{workspaceRoot}/workspace/button/polyfill.js",
        "{workspaceRoot}/workspace/i2c-scan/polyfill.js",
        "{workspaceRoot}/workspace/pir-sensor/polyfill.js",
        "{workspaceRoot}/workspace/adt7410/polyfill.js",
        "{workspaceRoot}/workspace/sht30/polyfill.js",
        "{workspaceRoot}/workspace/ads1115/polyfill.js"
      ],
      "options": {
        "outputPath": "libs/browser-polyfill/dist",
        "configFile": "libs/browser-polyfill/vite.bundle.config.mts",
        "skipTypeCheck": true
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "{workspaceRoot}/coverage/libs/browser-polyfill"
      }
    }
  }
}
