# Browser Editor publish / auth (#181 / #269). Copy to .env if you
# need to override defaults. .env is gitignored. Do not commit
# passwords. Interactive ./scripts/start.sh writes
# CHIRIMEN_EDITOR_PASSWORD here on first 64-bit start when unset.
#
# Host bind for Editor 8080, Example 4173, and Catalog 4200.
# Default is localhost only. LAN opt-in: 0.0.0.0
# or ./scripts/start.sh --lan
CHIRIMEN_PUBLISH_BIND=127.0.0.1

# Set during interactive first start (#269). start.sh injects this as
# PASSWORD only when non-empty. Non-interactive / CI / already-set
# skips the prompt. Unset then generates into the
# chirimen-editor-config volume (config.yaml). Do not put PASSWORD=
# in compose.yaml (empty string can break auth). auth: none is not
# used.
CHIRIMEN_EDITOR_PASSWORD=

# Optional. Argon2 hash. Takes precedence over CHIRIMEN_EDITOR_PASSWORD.
# In Compose YAML the hash's $ must be written as $$. start.sh passes
# the host value as HASHED_PASSWORD without that rewrite.
CHIRIMEN_EDITOR_HASHED_PASSWORD=
