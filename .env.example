# Browser Editor publish / auth (#181). Copy to .env if you need to
# override defaults. .env is gitignored. Do not commit passwords.
#
# Host bind for Editor 8080, Example 4173, and Web Demo 4200.
# Default is localhost only. LAN opt-in: 0.0.0.0
# or ./scripts/start.sh --editor --lan
CHIRIMEN_PUBLISH_BIND=127.0.0.1

# Optional. Pin code-server password. Unset = generate into the
# chirimen-editor-config volume (config.yaml). start.sh --editor
# injects this as PASSWORD only when non-empty. Do not put PASSWORD=
# in compose.yaml (empty string can break auth).
CHIRIMEN_EDITOR_PASSWORD=

# Optional. Argon2 hash. Takes precedence over CHIRIMEN_EDITOR_PASSWORD.
# In Compose YAML the hash's $ must be written as $$. start.sh passes
# the host value as HASHED_PASSWORD without that rewrite.
CHIRIMEN_EDITOR_HASHED_PASSWORD=
